local function scanAndInspect()
    local selectedMatches = {}
    local heaviestEgg, maxW = nil, -1
    for _, item in pairs(workspace:GetDescendants()) do
        if (item:IsA("Model") or item:IsA("Tool")) and isWildEgg(item) then
            local isKnown = false
            for _, en in ipairs(eggList) do
                if string.find(string.lower(item.Name), string.lower(en)) then isKnown = true break end
            end
            if isKnown then
                local w = parseEggWeight(item)
                if w > maxW then maxW = w; heaviestEgg = item
                elseif w == 0 and maxW == -1 then heaviestEgg = item end
                if currentTargetEgg and string.find(string.lower(item.Name), string.lower(currentTargetEgg)) then
                    table.insert(selectedMatches, item)
                end
            end
        end
    end
    return selectedMatches, heaviestEgg
end

local function scanForFarmQueue()
    local eggsByName = {}
    for _, item in pairs(workspace:GetDescendants()) do
        if (item:IsA("Model") or item:IsA("Tool")) and isWildEgg(item) and not item:GetAttribute("FakeEgg") then
            for _, en in ipairs(eggList) do
                if string.find(string.lower(item.Name), string.lower(en)) then 
                    if not eggsByName[en] then eggsByName[en] = {} end
                    table.insert(eggsByName[en], item); break 
                end
            end
        end
    end
    for index, queueName in ipairs(selectedEggs) do
        if eggsByName[queueName] and #eggsByName[queueName] > 0 then return eggsByName[queueName][1], index end
    end
    return nil, nil
end

local function updateInspectorESP()
    clearESP()
    local myChar = player.Character; local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local selectedMatches, heaviestEgg = scanAndInspect()
    
    if heaviestEgg then
        local p = heaviestEgg:FindFirstChild("Handle") or heaviestEgg:FindFirstChild("EggBase") or heaviestEgg.PrimaryPart or heaviestEgg:FindFirstChildWhichIsA("BasePart")
        local dist = (myHRP and p) and math.floor((myHRP.Position - p.Position).Magnitude) or 0
        heavyTitle.Text = string.format("👑 HEAVIEST: <font color=\"#EAB308\"><b>%s</b></font>", heaviestEgg.Name)
        heavyInfo.Text = string.format("W: <font color=\"#F59E0B\"><b>%s</b></font> | Dist: <b>%dm</b>", getFormattedWeight(heaviestEgg), dist)
        if p then createTextESPOnly(heaviestEgg, p, true) end
    else
        heavyTitle.Text = "👑 HEAVIEST: <font color=\"#EF4444\">Not Found</font>"; heavyInfo.Text = "Weight: - | Dist: -"
    end
    
    if currentTargetEgg then
        if #selectedMatches > 0 then
            local nearestDist = math.huge; local bestMatch = selectedMatches[1]
            for _, egg in pairs(selectedMatches) do
                local p = egg:FindFirstChild("Handle") or egg:FindFirstChild("EggBase") or egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
                if p then
                    local d = myHRP and math.floor((myHRP.Position - p.Position).Magnitude) or 0
                    if d < nearestDist then nearestDist = d; bestMatch = egg end
                    if egg ~= heaviestEgg then createTextESPOnly(egg, p, false) end
                end
            end
            infoLabel.Text = string.format("Found: <font color=\"#10B981\"><b>%d</b></font> | Nearest: <b>%dm</b> | W: <b>%s</b>", #selectedMatches, nearestDist, getFormattedWeight(bestMatch))
        else
            infoLabel.Text = "Status: <font color=\"#EF4444\">Target Not Spawned</font>"
        end
    end
end

local eggPreviewCache = {}
local function getEggPreviewModel(eggName)
    if eggPreviewCache[eggName] ~= nil then return eggPreviewCache[eggName] end
    local model = nil
    pcall(function()
        local assets = rs:FindFirstChild("Assets"); local eggsFolder = assets and assets:FindFirstChild("Eggs")
        local template = eggsFolder and eggsFolder:FindFirstChild(eggName)
        if template and template:IsA("Model") then
            model = template:Clone()
            for _, v in pairs(model:GetDescendants()) do
                if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("Highlight") then v:Destroy()
                elseif v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false; v.CanQuery = false; v.CanTouch = false
                elseif v:IsA("ParticleEmitter") or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then v.Enabled = false end
            end
        end
    end)
    eggPreviewCache[eggName] = model or false
    return model
end

local function createEggPreview(parent, eggName)
    local model = getEggPreviewModel(eggName)
    if not model then return nil end
    local ok, frame = pcall(function()
        local vp = Instance.new("ViewportFrame")
        vp.Size = UDim2.new(1, -8, 1, -26); vp.Position = UDim2.new(0, 4, 0, 3); vp.BackgroundTransparency = 1
        vp.Ambient = Color3.fromRGB(215, 215, 225); vp.LightColor = Color3.fromRGB(255, 255, 255)
        vp.LightDirection = Vector3.new(-0.4, -1, -0.6); vp.Parent = parent; model.Parent = vp
        local cam = Instance.new("Camera"); cam.FieldOfView = 40; cam.Parent = vp; vp.CurrentCamera = cam
        local cf, size = model:GetBoundingBox()
        local maxDim = math.max(size.X, size.Y, size.Z)
        if not maxDim or maxDim <= 0 then maxDim = 1 end
        local dist = maxDim * 1.9
        cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, maxDim * 0.22, dist), cf.Position)
        return vp
    end)
    if not ok then return nil end
    return frame
end

