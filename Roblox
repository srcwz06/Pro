local function toggleSpectate(egg, activeBtn)
    if isSpectating then stopSpectating(); return end
    if not egg or not egg.Parent then return end
    local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    isSpectating = true; activeBtn.Text = "🔙 Stop View"; activeBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    egg.Archivable = true; localEggClone = egg:Clone(); egg.Archivable = false
    if localEggClone then
        for _, v in pairs(localEggClone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy()
            elseif v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false end
        end
        localEggClone.Parent = workspace.CurrentCamera
        local targetPart = localEggClone:FindFirstChild("Handle") or localEggClone:FindFirstChild("EggBase") or localEggClone.PrimaryPart or localEggClone:FindFirstChildWhichIsA("BasePart")
        if targetPart then local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -5); localEggClone:PivotTo(spawnCFrame)
        else localEggClone:Destroy(); stopSpectating() end
    end
end
