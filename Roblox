-- -------------------------------------------------------------
-- Auto Server Hop Logic
-- -------------------------------------------------------------
local visitedServers = {}
local function hopLowPlayerServer()
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local reqUrl = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(placeId))
    
    local success, response = pcall(function()
        if request then return request({Url = reqUrl, Method = "GET"})
        elseif http_request then return http_request({Url = reqUrl, Method = "GET"})
        elseif syn and syn.request then return syn.request({Url = reqUrl, Method = "GET"}) end
    end)
    
    if success and response and response.Body then
        local data = httpService:JSONDecode(response.Body)
        if data and data.data then
            local possibleServers = {}
            for _, srv in ipairs(data.data) do
                if srv.playing == 1 and srv.id ~= currentJobId and not visitedServers[srv.id] then
                    table.insert(possibleServers, srv.id)
                end
            end
            if #possibleServers > 0 then
                local targetServerId = possibleServers[math.random(1, #possibleServers)]
                visitedServers[targetServerId] = true
                teleportService:TeleportToPlaceInstance(placeId, targetServerId, player)
                return true
            end
        end
    end
    teleportService:Teleport(placeId, player)
end

-- -------------------------------------------------------------
-- FPS Boost (Potato Mode) Logic
-- -------------------------------------------------------------
local function enablePotatoMode()
    local lighting = game:GetService("Lighting")
    lighting.GlobalShadows = false
    lighting.FogEnd = 9e9
    lighting.Brightness = 1
    
    for _, v in pairs(lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("Atmosphere") then
            v.Enabled = false
        end
    end

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
            v.CastShadow = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v:Destroy()
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
            v.Enabled = false
        elseif v:IsA("Model") then
            local name = string.lower(v.Name)
            if name:find("tree") or name:find("bush") or name:find("grass") or name:find("plant") or name:find("leaf") then
                v:Destroy()
            end
        end
    end
    
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
end

