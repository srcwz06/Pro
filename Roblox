BindConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Bindings.Aim then
        toggleAimbot()
    elseif input.KeyCode == Bindings.Lock then 
        if isAimbotting then
            if hardLockedPlayer then
                hardLockedPlayer = nil
                Status.Text = "เธเธฅเธ”เธฅเนเธญเธเน€เธเธฒเธฐเธเธ (เน€เธฅเนเธเธ•เธฒเธกเน€เธกเธฒเธชเนเธ•เนเธญ)"
                HardLockBtn.Text = " ๐”’ เธเธธเนเธกเธฅเนเธญเธเน€เธเธฒเธฐเธเธเน€เธเนเธฒเธซเธกเธฒเธข"
                HardLockBtn.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
            else
                if currentTarget then
                    hardLockedPlayer = currentTarget
                    Status.Text = "๐”’ เธฅเนเธญเธเธ•เธฒเธขเธ•เธฑเธงเธ—เธตเน: " .. hardLockedPlayer.Name
                    HardLockBtn.Text = " ๐”’ เธเธฅเธ”เธฅเนเธญเธเน€เธเนเธฒเธซเธกเธฒเธข"
                    HardLockBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
                end
            end
        end
    elseif input.KeyCode == Bindings.Del then
        ToggleDeleteMode()
    end
    
    if input.KeyCode == Bindings.Pole and PoleModeEnabled then
        local hit = poleMouse.Hit
        if hit then
            local truss = Instance.new("TrussPart")
            truss.Size = Vector3.new(2, 40, 2); truss.Position = hit.Position + Vector3.new(0, 20, 0) 
            truss.Anchored = true; truss.BrickColor = BrickColor.new("Bright yellow") 
            truss.Material = Enum.Material.Neon; truss.Parent = workspace
            table.insert(SpawnedPoles, truss)
        end
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton3 then
        if DeleteModeEnabled and currentHoverObject then
            table.insert(ClickDeletedObjects, {
                obj = currentHoverObject,
                origTransparency = currentHoverObject.Transparency,
                origCanCollide = currentHoverObject.CanCollide,
                origCanQuery = currentHoverObject.CanQuery
            })
            currentHoverObject.CanCollide = false
            currentHoverObject.Transparency = 1
            pcall(function() currentHoverObject.CanQuery = false end)
            currentHoverObject = nil
            hoverHighlight.Adornee = nil
        end
    end
end))

