local function isPlayerCharacter(part)
    if not part then return false end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then return true end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return true end
    return false
end

-- [เธเธฑเธเธเนเธเธฑเธเธฅเนเธฒเธเธเธฒเธ]
_G.UtilityHubCleanup = function()
    for _, conn in ipairs(MyConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    for obj, data in pairs(MapDeletedObjects) do
        if obj then pcall(function() obj.Transparency = data.origTransparency; obj.CanCollide = data.origCanCollide; if data.origCanQuery ~= nil then obj.CanQuery = data.origCanQuery end end) end
    end
    for _, data in ipairs(ClickDeletedObjects) do
        if data.obj then pcall(function() data.obj.Transparency = data.origTransparency; data.obj.CanCollide = data.origCanCollide; if data.origCanQuery ~= nil then data.obj.CanQuery = data.origCanQuery end end) end
    end
    for _, pole in ipairs(SpawnedPoles) do
        if pole then pcall(function() pole:Destroy() end) end
    end
    pcall(function()
        local Lighting = game:GetService("Lighting")
        if origAmbient then Lighting.Ambient = origAmbient end
        if origOutdoorAmbient then Lighting.OutdoorAmbient = origOutdoorAmbient end
        if origShadows ~= nil then Lighting.GlobalShadows = origShadows end
    end)
    pcall(function()
        for _, p in pairs(game:GetService("Players"):GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("PrankESP"); if hl then hl:Destroy() end
                local hpBar = p.Character:FindFirstChild("HealthESP"); if hpBar then hpBar:Destroy() end
                local bg = p.Character:FindFirstChild("WeaponESP_UI"); if bg then bg:Destroy() end
            end
        end
    end)
    pcall(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then char.Humanoid.WalkSpeed = 16 end
    end)
    
    if _G.UtilityUI then pcall(function() _G.UtilityUI:Destroy() end); _G.UtilityUI = nil end
    if _G.UtilityWarningUI then pcall(function() _G.UtilityWarningUI:Destroy() end); _G.UtilityWarningUI = nil end
    if _G.UtilityCorpseFolder then pcall(function() _G.UtilityCorpseFolder:Destroy() end); _G.UtilityCorpseFolder = nil end
    if _G.UtilityFOVUI then pcall(function() _G.UtilityFOVUI:Destroy() end); _G.UtilityFOVUI = nil end
end

