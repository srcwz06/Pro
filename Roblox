local eggPreviewCache = {}
local function getEggPreviewModel(eggName)
    if eggPreviewCache[eggName] ~= nil then return eggPreviewCache[eggName] end
    local model = nil
    pcall(function()
        local assets = rs:FindFirstChild("Assets")
        local eggsFolder = assets and assets:FindFirstChild("Eggs")
        local template = eggsFolder and eggsFolder:FindFirstChild(eggName)
        if template and template:IsA("Model") then
            model = template:Clone()
            for _, v in pairs(model:GetDescendants()) do
                if v:IsA("Script") or v:IsA("LocalScript") then
                    v:Destroy()
                elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("Highlight") then
                    v:Destroy()
                elseif v:IsA("BasePart") then
                    v.Anchored = true
                    v.CanCollide = false
                    v.CanQuery = false
                    v.CanTouch = false
                elseif v:IsA("ParticleEmitter") or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
                    v.Enabled = false
                end
            end
        end
    end)
    eggPreviewCache[eggName] = model or false
    return model
end

local function createEggPreview(parent, eggName)
    local model = getEggPreviewModel(eggName)
    if not model then return nil end
    local ok, frame = pcall(function()
        local vp = Instance.new("ViewportFrame")
        vp.Size = UDim2.new(1, -8, 1, -26)
        vp.Position = UDim2.new(0, 4, 0, 3)
        vp.BackgroundTransparency = 1
        vp.Ambient = Color3.fromRGB(215, 215, 225)
        vp.LightColor = Color3.fromRGB(255, 255, 255)
        vp.LightDirection = Vector3.new(-0.4, -1, -0.6)
        vp.Parent = parent

        model.Parent = vp

        local cam = Instance.new("Camera")
        cam.FieldOfView = 40
        cam.Parent = vp
        vp.CurrentCamera = cam

        local cf, size = model:GetBoundingBox()
        local maxDim = math.max(size.X, size.Y, size.Z)
        if not maxDim or maxDim <= 0 then maxDim = 1 end
        local dist = maxDim * 1.9
        cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, maxDim * 0.22, dist), cf.Position)
        return vp
    end)
    if not ok then return nil end
    return frame
end

