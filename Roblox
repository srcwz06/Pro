    local ratio = math.clamp((inputPosX - barPos) / barSize, 0, 1)
    flySpeed = math.floor(minFlySpeed + (maxFlySpeed - minFlySpeed) * ratio)
    sliderFill.Size = UDim2.new(ratio, 0, 1, 0)
    sliderKnob.Position = UDim2.new(ratio, -7, 0.5, -7)
    speedLabel.Text = "🕊️ Speed: " .. tostring(flySpeed)
end
