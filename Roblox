local function toggleAimbot()
    if isAimbotting then
        stopAimbot()
        Status.Text = "เธเธดเธ”เธฃเธฐเธเธเธฅเนเธญเธเน€เธเนเธฒเนเธฅเนเธง"
        Status.TextColor3 = Colors.Status
        return
    end
    isAimbotting = true
    AimBtn.Text = " ๐ฏ เธเธณเธฅเธฑเธเน€เธฅเนเธ..."
    AimBtn.BackgroundColor3 = Colors.Green
    Status.Text = "เธเธณเธฅเธฑเธเธซเธฑเธเธเธฅเนเธญเธเธซเธฒเน€เธเนเธฒเธซเธกเธฒเธข!"
    Status.TextColor3 = Colors.ButtonAim

    aimbotConnection = BindConn(RunService.RenderStepped:Connect(function()
        if hardLockedPlayer then
            if hardLockedPlayer.Character and hardLockedPlayer.Character:FindFirstChild("HumanoidRootPart") and hardLockedPlayer.Character:FindFirstChild("Humanoid") and hardLockedPlayer.Character.Humanoid.Health > 0 then
                local targetPartObj = hardLockedPlayer.Character:FindFirstChild(AimTargetPart) or hardLockedPlayer.Character:FindFirstChild("HumanoidRootPart")
                
                local canAim = true
                if WallCheckEnabled then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, hardLockedPlayer.Character}
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.IgnoreWater = true
                    if workspace:Raycast(Camera.CFrame.Position, targetPartObj.Position - Camera.CFrame.Position, rayParams) ~= nil then
                        canAim = false
                    end
                end
                
                if canAim then
                    local aimPos = targetPartObj.Position
                    if PredictionEnabled then
                        local vel = targetPartObj.AssemblyLinearVelocity
                        if vel then aimPos = aimPos + (vel * PredictionAmt) end
                    end
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                    ProcessAutoShoot() 
                end
                return 
            else
                hardLockedPlayer = nil
                Status.Text = "เน€เธเนเธฒเธซเธกเธฒเธขเธ—เธตเนเธฅเนเธญเธเธซเธฒเธขเนเธ (เธเธฅเธฑเธเธชเธนเนเนเธซเธกเธ”เธซเธฒเธ•เธฒเธกเน€เธกเธฒเธชเน)"
            end
        end
        
        local closestPlayer = nil
        local shortestDistance = math.huge
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local partToAim = p.Character:FindFirstChild(AimTargetPart) or p.Character:FindFirstChild("HumanoidRootPart")
                local pos, onScreen = Camera:WorldToViewportPoint(partToAim.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    local isValidTarget = true
                    
                    if FOVEnabled and dist > FOVRadius then isValidTarget = false end
                    
                    if WallCheckEnabled and isValidTarget then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, p.Character}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        rayParams.IgnoreWater = true
                        if workspace:Raycast(Camera.CFrame.Position, partToAim.Position - Camera.CFrame.Position, rayParams) ~= nil then 
                            isValidTarget = false 
                        end
                    end
                    
                    if isValidTarget and dist < shortestDistance then
                        closestPlayer = p
                        shortestDistance = dist
                    end
                end
            end
        end
        currentTarget = closestPlayer
        
        if currentTarget and currentTarget.Character then
            local targetPartObj = currentTarget.Character:FindFirstChild(AimTargetPart) or currentTarget.Character:FindFirstChild("HumanoidRootPart")
            local aimPos = targetPartObj.Position
            if PredictionEnabled then
                local vel = targetPartObj.AssemblyLinearVelocity
                if vel then aimPos = aimPos + (vel * PredictionAmt) end
            end
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
            ProcessAutoShoot() 
        end
    end))
end
