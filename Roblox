local function grabAndReturn(egg)
    if isGrabbing then return end
    -- 🧪 ไข่จำลองเก็บไม่ได้จริง (เซิร์ฟเวอร์ไม่รู้จัก) แต่ "Volcanic ปลอม" ใช้ทดสอบทัวร์ประตู Lair ได้
    -- ไข่ปลอมชนิดอื่น = ไม่ตอบสนอง กันวาปไปหยิบไข่ปลอมเสียเวลา
    if not egg or not egg.Parent then return end
    local isFakeTest = egg:GetAttribute("FakeEgg") == true
    if isFakeTest and not string.find(string.lower(egg.Name), "volcanic", 1, true) then return end
    local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not egg or not egg.Parent then return end
    local targetPart = egg:FindFirstChild("Handle") or egg:FindFirstChild("EggBase") or egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
    if not targetPart then return end
    if not homeCFrame then homeCFrame = findAutoPlotCFrame() end
    
    isGrabbing = true
    hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero; local eggName = egg.Name
    
    -- 🚪 Volcanic Egg เกิดในรัง Volkaris (Lair) เกมบังคับว่าต้อง "เดินผ่านประตู VolcanoEntrance" ก่อนถึงเก็บได้
    -- 🔥 ยืนยันความสำเร็จด้วยบัฟ "Scorching" (PlayerGui.Main.ActiveWeathers.Scorching) ที่โผล่เฉพาะตอนเกมนับว่าเราอยู่ในภูเขาไฟ
    -- บินลื่น ๆ ผ่านประตูจริง (ไม่วาปกระชาก) → บินลงไปหาไข่ในรัง
    if string.find(string.lower(eggName), "volcanic", 1, true) then
        pcall(function()
            local function hasScorching()
                local pg = player:FindFirstChild("PlayerGui")
                local main = pg and pg:FindFirstChild("Main")
                local aw = main and main:FindFirstChild("ActiveWeathers")
                return aw ~= nil and aw:FindFirstChild("Scorching") ~= nil
            end
            local volc = workspace:FindFirstChild("Volcano")
            local doorPart = volc and volc:FindFirstChild("VolcanoEntrance")
            if doorPart and doorPart:IsA("BasePart") and hrp.Parent then
                local doorCF = doorPart.CFrame
                local skippedDoor = hasScorching() -- มีบัฟอยู่แล้ว (เข้าครั้งก่อน) = ข้ามประตู วาปเข้าหาไข่เลย
                -- 🔒 น็อคลิปต่อเนื่องตลอดทัวร์ประตู (จุดรอ/ช่วงพัก ก็ยัง noclip — กันโดนหินภูเขาเด้งออก)
                local tourNoclip = runService.Stepped:Connect(function()
                    if player.Character then
                        for _, cp in pairs(player.Character:GetDescendants()) do if cp:IsA("BasePart") then cp.CanCollide = false end end
                    end
                end)
                pcall(function()
                    if not skippedDoor then
                        -- 🏔️ ทำแบบตอนแรก: วาปลง "พื้นดินโคนเขา" จริง ๆ ก่อน (raycast หาพื้นหน้าเขา ห่างประตู 40 studs)
                        -- แล้วลอยขึ้นสู่ระดับประตู → ค่อย ๆ ทะลุเข้าไปให้เกมนับว่าเดินเข้า (Touched ยิงเองตามการเคลื่อนที่)
                        -- ไม่แน่ใจว่าประตูหันทางไหน → รอบ 1 ลองจากฝั่ง -Z รอบ 2 ฝั่ง +Z รอบ 3 กลับไป -Z
                        for doorTry = 1, 3 do
                            local outSign = (doorTry == 2) and 1 or -1
                            local basePoint = (doorCF * CFrame.new(0, 0, 40 * outSign)).Position
                            local groundRay = workspace:Raycast(basePoint + Vector3.new(0, 400, 0), Vector3.new(0, -800, 0))
                            if groundRay then
                                hrp.CFrame = CFrame.new(groundRay.Position + Vector3.new(0, 4, 0)) -- ยืนบนพื้นดินโคนเขา
                            else
                                hrp.CFrame = doorCF * CFrame.new(0, -3, 40 * outSign) -- หาพื้นไม่เจอ ใช้จุดเผื่อ
                            end
                            hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.1)
                            volcFlyTo(hrp, (doorCF * CFrame.new(0, 0, 30 * outSign)).Position, 150) -- ลอยขึ้นสูงระดับประตู
                            volcFlyTo(hrp, (doorCF * CFrame.new(0, 0, 6 * outSign)).Position, 100) -- เข้าหน้าประตู
                            volcFlyTo(hrp, doorCF.Position, 90) -- ทะลุกลางประตูช้า ๆ ให้ทริกเกอร์ยิงแน่ ๆ
                            pcall(function() if firetouchinterest then firetouchinterest(hrp, doorPart, 0); firetouchinterest(hrp, doorPart, 1) end end)
                            volcFlyTo(hrp, (doorCF * CFrame.new(0, 5, 45 * -outSign)).Position, 90) -- ลอยเข้าไปลึกขึ้นในถ้ำ (ไม่หยุดแค่ปากประตู)
                            local buffWait = os.clock(); local holdCF = hrp.CFrame
                            while os.clock() - buffWait < 1.5 do
                                local hh = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                                if hh then hh.CFrame = holdCF; hh.AssemblyLinearVelocity = Vector3.zero; hh.AssemblyAngularVelocity = Vector3.zero end -- 🔒 ล็อคตำแหน่ง กันตกทะลุพื้นระหว่างรอ (noclip เปิดอยู่)
                                if hasScorching() then break end
                                task.wait(0.1)
                            end
                            if hasScorching() then lairOutSign = outSign break end -- บัฟขึ้น = เข้าได้จริง + จำทิศนอกไว้
                        end
                    end
                    -- 🏃 ลงไปหาไข่: ลอยลื่น ๆ จากในถ้ำลงไปที่ตัวไข่ (ไม่วาปดิ่งหาไข่)
                    -- ถ้าข้ามประตู (มีบัฟอยู่แล้ว) → วาปไปจุดเริ่ม "ในถ้ำ" ก่อน แล้วลอยลงหาไข่เหมือนกัน
                    if targetPart and targetPart.Parent and not isFakeTest then
                        if skippedDoor then
                            hrp.CFrame = doorCF * CFrame.new(0, 5, 45 * -lairOutSign) -- จุดเริ่มในถ้ำ (ฝั่งในของประตู)
                            hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.05)
                        end
                        volcFlyTo(hrp, targetPart.Position + Vector3.new(0, 3, 0), 200)
                        -- ยืนในถ้ำแล้ว รอบัฟกลับมา (เกมอาจถอดระหว่างทาง) นานสุด 2 วิ — ล็อคตำแหน่งที่ไข่ กันตกทะลุพื้น
                        local reBuff = os.clock(); local eggHoldCF = hrp.CFrame
                        while os.clock() - reBuff < 2 do
                            local hh = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            if hh then hh.CFrame = eggHoldCF; hh.AssemblyLinearVelocity = Vector3.zero; hh.AssemblyAngularVelocity = Vector3.zero end
                            if hasScorching() then break end
                            task.wait(0.1)
                        end
                    end
                end)
                tourNoclip:Disconnect()
                lairEnteredAt = os.clock(); lairEnteredChar = player.Character
            end
        end)
    end
    
    -- 🧪 โหมดทดสอบทัวร์ประตู (ไข่ Volcanic ปลอม): ผ่านประตูแล้ววาปไปจุดเกิดไข่มังกรจริง (EggSpawns.Volcanic)
    -- ไม่ยิง remote เก็บ ไม่บินกลับบ้าน — ไว้ดูด้วยตาว่าทริกเกอร์ประตู + บัฟ Scorching ทำงานหรือไม่
    if isFakeTest then
        pcall(function()
            local spFolder = workspace:FindFirstChild("EggSpawns")
            local volcSpawn = spFolder and spFolder:FindFirstChild("Volcanic")
            if volcSpawn and volcSpawn:IsA("BasePart") and hrp.Parent then
                hrp.CFrame = volcSpawn.CFrame + Vector3.new(0, 4, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
        task.wait(0.1)
        isGrabbing = false
        return
    end
    
    if tpMode == 2 then
        local originalPos = homeCFrame or hrp.CFrame; hrp.CFrame = targetPart.CFrame + Vector3.new(0, 1.5, 0)
        if os.clock() - lastRemoteCall > 0.1 then
            lastRemoteCall = os.clock()
            pcall(function()
                if eggPickupRemote then eggPickupRemote:FireServer(egg) end
                local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then prompt.HoldDuration = 0 if fireproximityprompt then fireproximityprompt(prompt) end end
            end)
        end
        task.wait(0.05)
        hrp.CFrame = originalPos
        pcall(function() if tpPlotRemote then tpPlotRemote:FireServer() end; if basketDropRemote then basketDropRemote:FireServer() end; if eggPlacedRemote then eggPlacedRemote:FireServer() end end)
    elseif tpMode == 3 then
        local targetHomeCF = homeCFrame or findAutoPlotCFrame() or hrp.CFrame; local beforeCount, _ = countOwnedEggs(eggName)
        -- 🎯 ยืนจุดเก็บจริง: อ้างจาก ProximityPrompt ของไข่ก่อน (จุดที่เกมให้กดเก็บ) ไม่ใช่กึ่งกลางโมเดล
        local interactPart = targetPart
        pcall(function()
            local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Parent then
                local pp = prompt.Parent
                if pp:IsA("BasePart") then interactPart = pp
                elseif pp:IsA("Attachment") and pp.Parent and pp.Parent:IsA("BasePart") then interactPart = pp.Parent end
            end
        end)
        -- 📏 ไข่ตัวใหญ่: คำนวณรัศมีจากขนาดจริง เพื่อยืนนอกตัวไข่ (ยืนทับจะโดน hitbox ดันออก เก็บไม่ติด)
        local eggRadius = 2.0
        pcall(function()
            local s = interactPart.Size
            if s and s.Magnitude > 0 then eggRadius = math.max(s.X, s.Z) * 0.5 end
        end)
        local off = math.min(eggRadius + 2.5, 8.0)
        local standCandidates = {
            Vector3.new(off, 2.0, 0), Vector3.new(-off, 2.0, 0),
            Vector3.new(0, 2.0, off), Vector3.new(0, 2.0, -off),
            Vector3.new(2.0, 1.5, 0),
            Vector3.new(0, math.min(eggRadius + 3.0, 10.0), 0),
        }
        local candIdx = 1
        local attempt = 0
        local function standAtEgg()
            local base = (interactPart and interactPart.Parent) and interactPart.Position or targetPart.Position
            local sp = base + standCandidates[candIdx]
            hrp.CFrame = CFrame.lookAt(sp, Vector3.new(base.X, sp.Y, base.Z))
            hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
        end
        standAtEgg()
        
        local startTime = os.clock()
        -- 🔁 พยายามนานขึ้น (15 วิ): ได้ไข่เข้ามือก่อนถึงจะบินกลับ ไม่กลับมือเปล่าเร็ว ๆ
        while (os.clock() - startTime < 15.0) do
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then break end
            hrp = player.Character.HumanoidRootPart
            for _, cp in pairs(player.Character:GetDescendants()) do if cp:IsA("BasePart") then cp.CanCollide = false end end -- noclip ตอนพยายามเก็บ กันโดน hitbox ไข่ยักษ์ดันออก
            if egg and egg.Parent and interactPart and interactPart.Parent then
                attempt = attempt + 1
                standAtEgg()
                if attempt % 6 == 0 then candIdx = (candIdx % #standCandidates) + 1 end -- หมุนเปลี่ยนจุดยืนรอบไข่ทุก ~0.6 วิ หาจุดที่เก็บติด
                pcall(function()
                    if eggPickupRemote then eggPickupRemote:FireServer(egg) end
                    local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        prompt.HoldDuration = 0; prompt.MaxActivationDistance = math.huge
                        if fireproximityprompt then fireproximityprompt(prompt) end
                    end
                    local cd = egg:FindFirstChildWhichIsA("ClickDetector", true)
                    if cd and fireclickdetector then fireclickdetector(cd) end
                    if firetouchinterest and hrp then firetouchinterest(hrp, interactPart, 0); firetouchinterest(hrp, interactPart, 1) end
                end)
            end
            local nowCount, inHand = countOwnedEggs(eggName)
            local eggGoneFromWild = (not egg or not egg.Parent or not isWildEgg(egg))
            if nowCount > beforeCount or (eggGoneFromWild and (inHand or ensureEggInHand(eggName))) then
                ensureEggInHand(eggName)
                local confirmStart = os.clock()
                while os.clock() - confirmStart < 0.35 do
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero; player.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                    end
                    ensureEggInHand(eggName); task.wait(0.05)
                end
                local finalCount, finalInHand = countOwnedEggs(eggName)
                if finalInHand or finalCount > beforeCount or (not egg or not egg.Parent or not isWildEgg(egg)) then break end
            end
            if eggGoneFromWild and (os.clock() - startTime > 1.2) then break end
            task.wait(0.08)
        end
        
        -- 🚪 Volcanic: ออกจากรัง "เรียงตามจุดพิกัดจริง" ที่บันทึกไว้ (LAIR_EXIT_WP 1→11) แล้วค่อยบินกลับบ้าน
        if string.find(string.lower(eggName), "volcanic", 1, true) then
            runLairExitRoute()
        end
        
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end

        local noclipConn = runService.Stepped:Connect(function()
            if player.Character then
                for _, part in pairs(player.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
            end
        end)
        
        local flyHeightOffset = Vector3.new(0, 12, 0)
        local destPos = targetHomeCF.Position + flyHeightOffset
        local flyStart = os.clock(); local lastStep = os.clock()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            hrp = player.Character.HumanoidRootPart; hrp.CFrame = CFrame.new(hrp.Position + flyHeightOffset)
            hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
        end
        while (os.clock() - flyStart < 25) do
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then break end
            hrp = player.Character.HumanoidRootPart
            local now = os.clock(); local dt = math.clamp(now - lastStep, 0.005, 0.1); lastStep = now
            local currentPos = hrp.Position; local diff = destPos - currentPos; local dist = diff.Magnitude
            if dist <= 2.5 then break end
            local currentSpeed = flySpeed
            if dist < 35 then currentSpeed = math.clamp(flySpeed * (dist / 35), 40, flySpeed) end
            local stepDist = math.min(dist, currentSpeed * dt); local nextPos = currentPos + (diff.Unit * stepDist)
            hrp.CFrame = CFrame.new(nextPos) * targetHomeCF.Rotation; hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
            runService.Heartbeat:Wait()
        end
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            hrp = player.Character.HumanoidRootPart; hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = targetHomeCF; hrp.Anchored = true
        end
        if noclipConn then noclipConn:Disconnect() end
        if player.Character then for _, part in pairs(player.Character:GetDescendants()) do if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end end end
        task.wait(0.12)
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            hrp = player.Character.HumanoidRootPart; hrp.Anchored = false; hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero; hrp.CFrame = targetHomeCF
        end
        hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        task.wait(0.1)
        pcall(function() if tpPlotRemote then tpPlotRemote:FireServer() end; if basketDropRemote then basketDropRemote:FireServer() end; if eggPlacedRemote then eggPlacedRemote:FireServer() end end)
    else
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 1.5, 0); task.wait(0.2)
        if os.clock() - lastRemoteCall > 0.25 then
            lastRemoteCall = os.clock()
            pcall(function()
                if eggPickupRemote then eggPickupRemote:FireServer(egg) end
                local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then prompt.HoldDuration = 0 if fireproximityprompt then fireproximityprompt(prompt) end end
            end)
        end
        task.wait(0.25)
        if homeCFrame then hrp.CFrame = homeCFrame end
        pcall(function() if tpPlotRemote then tpPlotRemote:FireServer() end; if basketDropRemote then basketDropRemote:FireServer() end; if eggPlacedRemote then eggPlacedRemote:FireServer() end end)
    end
    task.wait(0.1)
    unequipAllTools()
    isGrabbing = false
end

