-- ถ้าอยากสลับลำดับระดับ rarity แก้เลขใน RARITY_RANK ได้เลย (มาก = อยู่บน)
local RARITY_RANK = {
    ["Secret"]    = 9,
    ["Volcanic"]  = 8,
    ["Ethereal"]  = 7,
    ["Divine"]    = 6,
    ["Mythic"]    = 5,
    ["Legendary"] = 4,
    ["Epic"]      = 3,
    ["Rare"]      = 2,
    ["Common"]    = 1,
}
local eggOrderIndex = {}
for i, name in ipairs(eggList) do eggOrderIndex[name] = i end
table.sort(eggList, function(a, b)
    local ra = (eggDataDict[a] and RARITY_RANK[eggDataDict[a].Rarity]) or 0
    local rb = (eggDataDict[b] and RARITY_RANK[eggDataDict[b].Rarity]) or 0
    if ra ~= rb then return ra > rb end
    -- ระดับเท่ากัน: คงลำดับเดิมของรายการไว้ (เรียงเสถียร)
    return (eggOrderIndex[a] or 0) < (eggOrderIndex[b] or 0)
end)

