local visitedServers = {}
local function hopLowPlayerServer()
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local reqUrl = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(placeId))
    
    local success, response = pcall(function()
        if request then return request({Url = reqUrl, Method = "GET"})
        elseif http_request then return http_request({Url = reqUrl, Method = "GET"})
        elseif syn and syn.request then return syn.request({Url = reqUrl, Method = "GET"}) end
    end)
    
    if success and response and response.Body then
        local data = httpService:JSONDecode(response.Body)
        if data and data.data then
            local possibleServers = {}
            for _, srv in ipairs(data.data) do
                if srv.playing == 1 and srv.id ~= currentJobId and not visitedServers[srv.id] then
                    table.insert(possibleServers, srv.id)
                end
            end
            if #possibleServers > 0 then
                local targetServerId = possibleServers[math.random(1, #possibleServers)]
                visitedServers[targetServerId] = true
                teleportService:TeleportToPlaceInstance(placeId, targetServerId, player)
                return true
            end
        end
    end
    teleportService:Teleport(placeId, player)
end

-- 🥔 BOOST FPS : โหมดประหยัดกราฟิก (กดซ้ำเพื่อคืนค่าทุกอย่างกลับเหมือนเดิม)
local boostActive = false
local boostUndo = {}                                    -- รายการคืนค่า (เก็บค่าตัวเก่าไว้)
local boostDone = setmetatable({}, { __mode = "k" })   -- กันประมวลผล instance ซ้ำ
local boostConn = nil
local boostProtectedRoots = { parentGui }               -- UI ของเราห้ามแตะ

local function boostProtected(inst)
    for _, root in ipairs(boostProtectedRoots) do
        if root and inst:IsDescendantOf(root) then return true end
    end
    return false
end

-- จำค่าเดิมไว้คืน แล้วตั้งค่าใหม่ (ถ้าไม่มีพร็อพนี้ในเวอร์ชันนี้ก็ข้ามไป)
local function boostSet(inst, prop, value)
    local ok, old = pcall(function() return inst[prop] end)
    if not ok then return end
    table.insert(boostUndo, function() pcall(function() inst[prop] = old end) end)
    pcall(function() inst[prop] = value end)
end

-- ถอดออกจากแมพชั่วคราว (คืนได้ เพราะเก็บ Parent เดิมไว้)
local function boostDetach(inst)
    local oldParent = inst.Parent
    if not oldParent then return end
    table.insert(boostUndo, function() pcall(function() inst.Parent = oldParent end) end)
    pcall(function() inst.Parent = nil end)
end

local function boostClean(inst)
    if boostDone[inst] or boostProtected(inst) then return end
    boostDone[inst] = true
    if inst:IsA("BasePart") then
        boostSet(inst, "Material", Enum.Material.SmoothPlastic)
        boostSet(inst, "Reflectance", 0)
        boostSet(inst, "CastShadow", false)
        if inst:IsA("MeshPart") then boostSet(inst, "TextureID", "") end -- ลบเท็กซ์เจอร์ mesh
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        boostSet(inst, "Texture", "")        -- ลบเท็กซ์เจอร์/ความชัด
        boostSet(inst, "Transparency", 1)
    elseif inst:IsA("SpecialMesh") then
        boostSet(inst, "TextureId", "")
    elseif inst:IsA("SurfaceAppearance") then
        boostDetach(inst)                     -- ลบ PBR (เงา/ความหยาบ)
    elseif inst:IsA("Highlight") then
        boostSet(inst, "Enabled", false)
    elseif inst:IsA("SelectionBox") or inst:IsA("SelectionSphere") then
        boostSet(inst, "Visible", false)
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
        boostSet(inst, "Enabled", false)
    elseif inst:IsA("Explosion") or inst:IsA("Clouds") or inst:IsA("Sky") then
        boostDetach(inst)
    elseif inst:IsA("Model") then
        local name = string.lower(inst.Name)
        -- ห้ามแตะอะไรที่ชื่อมีคำว่า egg (กันระบบฟาร์ม/ไข่หาย)
        if not name:find("egg") and (name:find("tree") or name:find("bush") or name:find("grass") or name:find("plant") or name:find("leaf")) then
            boostDetach(inst)                 -- ต้นไม้/หญ้า (ย้ายออก ไม่ Destroy -> คืนได้)
        end
    end
end

local function boostSweep()
    for _, inst in ipairs(workspace:GetDescendants()) do boostClean(inst) end
end

local function boostEnable()
    if boostActive then return end
    boostActive = true
    boostUndo = {}; boostDone = setmetatable({}, { __mode = "k" })

    local lighting = game:GetService("Lighting")
    boostSet(lighting, "GlobalShadows", false)
    boostSet(lighting, "FogEnd", 9e9)
    boostSet(lighting, "Brightness", 1)
    boostSet(lighting, "EnvironmentDiffuseScale", 0)
    boostSet(lighting, "EnvironmentSpecularScale", 0)
    for _, v in ipairs(lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
            boostSet(v, "Enabled", false)
        elseif v:IsA("Sky") or v:IsA("Clouds") then
            boostDetach(v)                        -- ท้องฟ้า/เมฆ (ย้ายออก คืนได้)
        end
    end

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        boostSet(terrain, "Decoration", false)   -- ปิดหญ้าประดับ
        boostSet(terrain, "GrassLength", 0)
        boostSet(terrain, "WaterWaveSize", 0)
        boostSet(terrain, "WaterWaveSpeed", 0)
        boostSet(terrain, "WaterTransparency", 1)
    end

    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

    boostSweep()

    -- เอฟเฟกต์ที่เกิดใหม่หลังกดบูสต์ ก็เก็บด้วย (ทั้งตอนเกิดใหม่และสแกนซ้ำ)
    if not boostConn then
        boostConn = workspace.DescendantAdded:Connect(function(inst)
            if boostActive then boostClean(inst) end
        end)
    end
end

local function boostDisable()
    if not boostActive then return end
    boostActive = false
    for i = #boostUndo, 1, -1 do pcall(boostUndo[i]) end
    boostUndo = {}; boostDone = setmetatable({}, { __mode = "k" })
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
end

