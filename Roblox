-- สแกนเฉพาะ Volcanic / Cherub / Solaris Egg ที่เกิดตามธรรมชาติในแมพ
local function findWhitelistedWildEggs()
    local found = {}
    for _, item in pairs(workspace:GetDescendants()) do
        if (item:IsA("Model") or item:IsA("Tool")) and isWildEgg(item) then
            local lowerName = string.lower(item.Name)
            for alertName in pairs(ALERT_EGG_WHITELIST) do
                if string.find(lowerName, string.lower(alertName)) then
                    table.insert(found, { Egg = item, Name = alertName })
                    break
                end
            end
        end
    end
    return found
end

task.spawn(function()
    while task.wait(1) do
        if notificationEnabled then
            -- ไข่ใหม่ = แจ้งซ้ำได้เลย แม้ป๊อปอัปเดิมยังค้างอยู่ (ไม่บล็อกการออโต้เก็บไข่)
            for _, found in ipairs(findWhitelistedWildEggs()) do
                if not notifiedEggs[found.Egg] then
                    notifiedEggs[found.Egg] = true
                    if not isNotifying then alertSound.TimePosition = 0 end
                    isNotifying = true
                    popupMsg.Text = "🎉 พบไข่แจ้งเตือน!\n[" .. found.Name .. "]"
                    popupFrame.Visible = true
                    alertSound:Play()
                    break
                end
            end
        end
        -- Clean up history for eggs that are gone / no longer wild
        for egg, _ in pairs(notifiedEggs) do
            if not egg or not egg.Parent or not isWildEgg(egg) then notifiedEggs[egg] = nil end
        end
    end
end)
