-- Real-Time Loops
runService.RenderStepped:Connect(function()
    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myHRP and #activeBillboards > 0 then
        for _, item in pairs(activeBillboards) do
            if item.Part and item.Part.Parent and item.Label and item.Label.Parent then
                local dist = math.floor((myHRP.Position - item.Part.Position).Magnitude)
                item.Label.Text = string.format("📍 %dm", dist)
            end
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        local timeLeft = 0
        pcall(function()
            if eggCycleService then
                local cycleMod = require(eggCycleService)
                if cycleMod.SecondsRemaining then timeLeft = math.floor(cycleMod.SecondsRemaining()) end
            else timeLeft = 480 - (math.floor(os.time()) % 480) end
        end)
        countdownLabel.Text = string.format("%02d:%02d", math.floor(timeLeft / 60), timeLeft % 60)
        secLogs.Text = string.format("• Anti-AFK (20m Timeout): ACTIVE\n• Ban/Kick Remotes: DROPPED\n• Total Intercepted Traps: %d", blockedRemotesCount)
    end
end)

task.spawn(function()
    while task.wait(1.5) do
        if not isFarming then updateInspectorESP() end
    end
end)

local lastQueueIndex = nil
local hasUnequippedOnEmpty = false 

task.spawn(function()
    while task.wait(0.4) do
        if isFarming and #selectedEggs > 0 then
            local targetToFarm, currentQueueIndex = scanForFarmQueue()
            if targetToFarm then
                
                hasUnequippedOnEmpty = false 
                
                if lastQueueIndex and currentQueueIndex > lastQueueIndex then
                    task.wait(1) 
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function() hum:UnequipTools() end)
                    end
                    task.wait(2) 
                    lastQueueIndex = currentQueueIndex
                else
                    grabAndReturn(targetToFarm)
                    lastQueueIndex = currentQueueIndex
                    task.wait(useFlashTP and 0.2 or 0.4)
                end
                
            else
                lastQueueIndex = nil
                
                if not hasUnequippedOnEmpty then
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function() hum:UnequipTools() end)
                    end
                    hasUnequippedOnEmpty = true 
                end
            end
        else
            lastQueueIndex = nil
            hasUnequippedOnEmpty = false
        end
    end
end)

