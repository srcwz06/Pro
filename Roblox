local function countOwnedEggs(eggName)
    local count = 0; local inHand = false; local lowerName = string.lower(eggName); local char = player.Character
    if char then
        for _, v in pairs(char:GetChildren()) do
            if (v:IsA("Tool") or v:IsA("Model")) and string.find(string.lower(v.Name), lowerName) then count = count + 1; inHand = true end
        end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, v in pairs(bp:GetChildren()) do
            if (v:IsA("Tool") or v:IsA("Model")) and string.find(string.lower(v.Name), lowerName) then count = count + 1 end
        end
    end
    return count, inHand
end

local function ensureEggInHand(eggName)
    local char = player.Character; if not char then return false end; local lowerName = string.lower(eggName)
    for _, v in pairs(char:GetChildren()) do if (v:IsA("Tool") or v:IsA("Model")) and string.find(string.lower(v.Name), lowerName) then return true end end
    local bp = player:FindFirstChild("Backpack"); local hum = char:FindFirstChildOfClass("Humanoid")
    if bp and hum then
        for _, v in pairs(bp:GetChildren()) do
            if v:IsA("Tool") and string.find(string.lower(v.Name), lowerName) then pcall(function() hum:EquipTool(v) end); return true end
        end
    end
    return false
end

