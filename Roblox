local function runLairExitRoute()
    return pcall(function()
        local exitNoclip = runService.Stepped:Connect(function() -- 🔒 น็อคลิปต่อเนื่องตอนลอยออก กันโดนหินเด้ง
            if player.Character then
                for _, cp in pairs(player.Character:GetDescendants()) do if cp:IsA("BasePart") then cp.CanCollide = false end end
            end
        end)
        local hrpX = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrpX then
            for i, wp in ipairs(LAIR_EXIT_WP) do
                -- 🚀 เร่งระดับสูง: ตามทางจริงทุกจุด (ไม่ลัดโค้ง) — ปรับเลขได้ตรงนี้ (ยิ่งมากยิ่งเร็ว)
                local prevWp = LAIR_EXIT_WP[i - 1]
                local segLen = prevWp and (wp - prevWp).Magnitude or 0
                local spd = 300 -- ค่าฐาน (เดิม 130 → 200 → 300)
                if i >= #LAIR_EXIT_WP - 2 then spd = 110 -- ปากประตู/ทะลุออก: คงไว้ ห้ามเร็วกว่านี้ (ทริกเกอร์ต้องยิงทัน)
                elseif segLen > 0 and segLen < 40 then spd = 200 -- โค้งถี่ (เดิม 80 → 140 → 200)
                elseif segLen >= 90 then spd = 400 end -- ทางตรงยาว (เดิม 170 → 260 → 400)
                volcFlyTo(hrpX, wp, spd)
            end
        end
        exitNoclip:Disconnect()
    end)
end

