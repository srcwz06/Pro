        CorpseESPBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 160)
        
        task.spawn(function()
            while CorpseESPEnabled do
                local descendants = workspace:GetDescendants()
                local processCount = 0
                for i = 1, #descendants do
                    if not CorpseESPEnabled then break end
                    local obj = descendants[i]
                    local isTarget = false; local targetPart = nil; local espName = ""; local displayName = "๐’€ เธจเธ (Loot)"

                    if obj:IsA("ProximityPrompt") then
                        local text = (obj.ActionText or "") .. " " .. (obj.ObjectText or "")
