local function createHotkeyRow(yPos, text, bindKeyName, bgColor)
    local btn = Instance.new("TextButton", Main)
    btn.Size = UDim2.new(1, -56, 0, 35)
    btn.Position = UDim2.new(0, 12, 0, yPos)
    btn.BackgroundColor3 = bgColor
    btn.Text = " " .. text
    btn.TextColor3 = Colors.Text
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local keyBtn = Instance.new("TextButton", Main)
    keyBtn.Size = UDim2.new(0, 40, 0, 35)
    keyBtn.Position = UDim2.new(1, -52, 0, yPos)
    keyBtn.BackgroundColor3 = Colors.Panel
    keyBtn.Text = "[" .. Bindings[bindKeyName].Name .. "]"
    keyBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    keyBtn.TextSize = 11
    keyBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 6)

    local isBinding = false
    keyBtn.Activated:Connect(function()
        isBinding = true
        keyBtn.Text = "..."
        keyBtn.BackgroundColor3 = Color3.fromRGB(250, 204, 21)
        keyBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    end)

    BindConn(UserInputService.InputBegan:Connect(function(input, gp)
        if isBinding and input.UserInputType == Enum.UserInputType.Keyboard then
            Bindings[bindKeyName] = input.KeyCode
            keyBtn.Text = "[" .. input.KeyCode.Name .. "]"
            keyBtn.BackgroundColor3 = Colors.Panel
            keyBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            isBinding = false
        end
    end))

    return btn, keyBtn
end

