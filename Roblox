-- 🧪 ปุ่มจำลองไข่เกิด (ฝั่งเราเท่านั้น ไว้ทดสอบแจ้งเตือน/ESP ไม่ต้องรอไข่จริง) — กดซ้ำเพื่อลบทั้งหมด
local fakeEggList = {}
local fakeEggOrder = { "Volcanic Egg", "Cherub Egg", "Solaris Egg", "Diamond Egg", "Golden Egg" }
local function clearFakeEggs()
    for _, fe in pairs(fakeEggList) do pcall(function() fe:Destroy() end) end
    fakeEggList = {}
end
local function spawnFakeEgg(eggName)
    local template = nil
    pcall(function()
        local assets = rs:FindFirstChild("Assets"); local eggsFolder = assets and assets:FindFirstChild("Eggs")
        template = eggsFolder and eggsFolder:FindFirstChild(eggName)
    end)
    local model
    if template and template:IsA("Model") then
        template.Archivable = true; model = template:Clone(); template.Archivable = false
    else
        model = Instance.new("Model"); model.Name = eggName
        local part = Instance.new("Part"); part.Name = "EggBase"; part.Size = Vector3.new(2, 3, 2)
        part.CFrame = CFrame.new(0, -50, 0); part.Parent = model
    end
    model.Name = eggName
    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("Highlight") then v:Destroy()
        elseif v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false; v.CanQuery = false; v.CanTouch = false
        elseif v:IsA("ParticleEmitter") or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then v.Enabled = false end
    end
    local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then model:Destroy(); return end
    local angle = math.random() * math.pi * 2; local radius = 14 + math.random() * 8
    local pos = hrp.CFrame.Position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
    local ray = workspace:Raycast(pos + Vector3.new(0, 50, 0), Vector3.new(0, -200, 0))
    if ray then pos = ray.Position + Vector3.new(0, 2, 0) end
    model.Parent = workspace
    model:SetAttribute("FakeEgg", true) -- ใช้กัน Auto Farm ไล่เก็บไข่ปลอม
    model:PivotTo(CFrame.new(pos))
    table.insert(fakeEggList, model)
end
