-- [อัปเดตระบบ] ดึงไข่มาดูตรงหน้า (Local) - แก้ไขบัคไข่โดนลบ
-- ===========================================================
local isSpectating = false
local localEggClone = nil

local function stopSpectating()
    isSpectating = false
    if localEggClone then
        localEggClone:Destroy()
        localEggClone = nil
    end
    
    viewTargetBtn.Text = "👁️ View Target" 
    viewTargetBtn.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
    viewHvyBtn.Text = "👁️ View Hvy" 
    viewHvyBtn.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
end

local function toggleSpectate(egg, activeBtn)
    if isSpectating then
        stopSpectating()
        return
    end
    
    if not egg or not egg.Parent then return end
    
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    isSpectating = true
    activeBtn.Text = "🔙 Stop View"
    activeBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    
    -- โคลนไข่เป้าหมาย
    egg.Archivable = true
    localEggClone = egg:Clone()
    egg.Archivable = false
    
    if localEggClone then
        -- ลบสคริปต์และล็อคชิ้นส่วนไข่โคลน
        for _, v in pairs(localEggClone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Anchored = true
                v.CanCollide = false
            end
        end
        
        -- แก้ไข: นำไข่โคลนไปใส่ไว้ใน CurrentCamera แทน เพื่อไม่ให้โดนระบบ ESP ของเราลบทิ้ง
        localEggClone.Parent = workspace.CurrentCamera
        
        -- หาแกนหลักของไข่
        local targetPart = localEggClone:FindFirstChild("Handle") or localEggClone:FindFirstChild("EggBase") or localEggClone.PrimaryPart or localEggClone:FindFirstChildWhichIsA("BasePart")
        
        if targetPart then
            -- วางไข่ไว้ตรงหน้าตัวละคร (ห่าง 5 Studs)
            local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -5)
            localEggClone:PivotTo(spawnCFrame)
        else
            localEggClone:Destroy()
            stopSpectating()
        end
    end
end

viewTargetBtn.Activated:Connect(function()
    local selectedMatches, _ = scanAndInspect()
    if #selectedMatches > 0 or isSpectating then toggleSpectate(selectedMatches[1], viewTargetBtn) end
end)

viewHvyBtn.Activated:Connect(function()
    local _, heaviestEgg = scanAndInspect()
    if heaviestEgg or isSpectating then toggleSpectate(heaviestEgg, viewHvyBtn) end
end)

