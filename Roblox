        if not ch or not ch:FindFirstChild("HumanoidRootPart") then break end
        local h = ch.HumanoidRootPart
        for _, cp in pairs(ch:GetDescendants()) do if cp:IsA("BasePart") then cp.CanCollide = false end end
        local diff = targetPos - h.Position; local dist = diff.Magnitude
        if dist <= 3 then break end
        local now = os.clock(); local dt = math.clamp(now - lastStep, 0.005, 0.1); lastStep = now
        local stepDist = math.min(dist, speed * dt)
        h.CFrame = CFrame.new(h.Position + diff.Unit * stepDist)
        h.AssemblyLinearVelocity = Vector3.zero; h.AssemblyAngularVelocity = Vector3.zero
        runService.Heartbeat:Wait()
    end
end

