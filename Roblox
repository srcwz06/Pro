    b.BackgroundColor3 = Color3.fromRGB(80, 95, 120)
    b.BackgroundTransparency = 0.4
    b.LayoutOrder = i
    b.AutoButtonColor = true
    b.Parent = eggScroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", b)
    stroke.Color = data.Color
    stroke.Thickness = 1.2
    
    local img = Instance.new("ImageLabel", b)
    img.Size = UDim2.new(1, -12, 1, -26)
    img.Position = UDim2.new(0, 6, 0, 4)
    img.BackgroundTransparency = 1
    img.Image = data.Image
    img.ScaleType = Enum.ScaleType.Fit
    
    local nameLbl = Instance.new("TextLabel", b)
    nameLbl.Size = UDim2.new(1, -4, 0, 16)
    nameLbl.Position = UDim2.new(0, 2, 1, -18)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = data.Short
    nameLbl.TextColor3 = data.Color
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 10
    nameLbl.TextScaled = true

    -- 🆕 ไข่ใหม่ที่ยังไม่มีรูป: เรนเดอร์โมเดลไข่จริงในเกมแทน (ถ้าหาโมเดลไม่ได้ค่อยขยายชื่อเต็มปุ่ม)
    if not data.Image or data.Image == "" then
        img.Visible = false
        if not createEggPreview(b, eggName) then
            nameLbl.Size = UDim2.new(1, -4, 1, -8)
            nameLbl.Position = UDim2.new(0, 2, 0, 4)
        end
    end
    
    local badge = Instance.new("Frame", b)
    badge.Size = UDim2.new(0, 18, 0, 18)
    badge.Position = UDim2.new(1, -12, 0, -6)
    badge.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
    badge.Visible = false
    Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
    
    local queueTxt = Instance.new("TextLabel", badge)
    queueTxt.Size = UDim2.new(1, 0, 1, 0)
    queueTxt.BackgroundTransparency = 1
    queueTxt.Text = "1"
    queueTxt.TextColor3 = Color3.fromRGB(255, 255, 255)
    queueTxt.Font = Enum.Font.GothamBold
    queueTxt.TextSize = 10
    
    eggButtons[eggName] = { Button = b, Stroke = stroke, Badge = badge, QueueTxt = queueTxt, BaseColor = data.Color }
    
    local pressStartPos = nil
    local isPressing = false

    b.Activated:Connect(function()
        currentTargetEgg = eggName
        targetLabel.Text = "🎯 TARGET: <font color=\"#60A5FA\"><b>" .. data.Short .. "</b></font>"
        updateInspectorESP()
    end)

    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPressing = true
            pressStartPos = input.Position

            task.delay(3, function()
                if isPressing then
                    isPressing = false 
                    local idx = table.find(selectedEggs, eggName)
                    if idx then table.remove(selectedEggs, idx) else
                        if #selectedEggs < maxSelection then table.insert(selectedEggs, eggName) end
                    end
                    
                    for eName, btnObj in pairs(eggButtons) do
                        local currentIdx = table.find(selectedEggs, eName)
                        if currentIdx then
                            btnObj.QueueTxt.Text = tostring(currentIdx)
                            btnObj.Badge.Visible = true
                            btnObj.Stroke.Color = Color3.fromRGB(16, 185, 129)
                            btnObj.Stroke.Thickness = 2.5
                            btnObj.Button.BackgroundColor3 = Color3.fromRGB(20, 36, 30)
                            btnObj.Button.BackgroundTransparency = 0.2
                        else
                            btnObj.Badge.Visible = false
                            btnObj.Stroke.Color = btnObj.BaseColor
                            btnObj.Stroke.Thickness = 1.2
                            btnObj.Button.BackgroundColor3 = Color3.fromRGB(80, 95, 120)
                            btnObj.Button.BackgroundTransparency = 0.4
                        end
                    end
                    
                    if #selectedEggs == 0 and isFarming then
                        isFarming = false
                        farmBtn.Text = "⚡ AUTO FARM"
                        farmBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
                    end
                end
            end)
        end
    end)

    b.InputChanged:Connect(function(input)
        if isPressing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if pressStartPos and (input.Position - pressStartPos).Magnitude > 15 then isPressing = false end
        end
    end)

    b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPressing = false 
        end
    end)
end

